<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SimpleAnalyzer.App"
             RequestedThemeVariant="Dark">
  <!-- Dark only: the scope and spectrum are drawn in dark-theme colours. -->
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://SimpleAnalyzer/Styles.axaml" />
  </Application.Styles>
</Application>
